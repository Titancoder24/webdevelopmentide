# LLM IDE Configuration

# Gateway
GATEWAY_PORT=3001
GATEWAY_HOST=0.0.0.0

# MCP Server
MCP_PORT=3002

# Redis (for rate limiting, sessions)
REDIS_URL=redis://localhost:6379

# PostgreSQL (for auth, audit logs)
DATABASE_URL=postgresql://localhost:5432/llm_ide

# S3/R2 (for VFS snapshots)
S3_ENDPOINT=
S3_BUCKET=llm-ide-snapshots
S3_ACCESS_KEY=
S3_SECRET_KEY=

# JWT Secret
JWT_SECRET=change-me-in-production

# Frontend
NEXT_PUBLIC_GATEWAY_URL=http://localhost:3001
NEXT_PUBLIC_MCP_URL=http://localhost:3002
